    "search": { "required": ["identity", "area", "price", "configuration"] },
    "recommendations": { "required": ["identity", "area", "price", "configuration"] },
    "detail": { "required": ["identity", "area", "price", "configuration"] },
    "compare": { "required": ["identity", "area", "price", "configuration"] },
    "plan": { "required": ["identity", "area", "price", "configuration"] }
  },
