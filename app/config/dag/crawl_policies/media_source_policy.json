      "min_interval_hours": 168,
      "backoff_on_block_hours": 336,
      "domains": ["housing.com"],
      "trust_profile": "portal",
      "url_templates": [],
      "path_kind_rules": {
        "floor": "floor_plan",
        "amenity": "amenity",
        "elevation": "exterior",
        "project": "exterior"
      }
    },
    {
      "id": "99acres",
      "source_name": "99acres",
      "enabled": true,
      "priority": 60,
      "crawl_budget_per_run": 8,
      "min_interval_hours": 168,
      "backoff_on_block_hours": 336,
      "domains": ["99acres.com"],
      "trust_profile": "portal",
      "url_templates": [],
      "path_kind_rules": {
        "floor": "floor_plan",
        "amenity": "amenity",
        "elevation": "exterior",
        "project": "exterior"
      }
    },
    {
      "id": "nobroker",
      "source_name": "NoBroker",
      "enabled": true,
      "priority": 50,
      "crawl_budget_per_run": 6,
      "min_interval_hours": 168,
      "backoff_on_block_hours": 336,
      "domains": ["nobroker.in"],
      "trust_profile": "portal",
      "url_templates": [],
      "path_kind_rules": {
        "floor": "floor_plan",
        "amenity": "amenity",
