{
  "version": 1,
  "description": "Offline OpenStreetMap street-network paths from society access roads to operational transit stations.",
  "collector": {
    "source_id": "openstreetmap_transit_access",
    "source_type": "OpenStreetMap",
    "fetch_source": "overpass_access_corridor_snapshot",
    "overpass_url_env": "OPENESTATES_OVERPASS_API_URL",
    "default_overpass_url": "https://overpass-api.de/api/interpreter",
    "query_timeout_seconds": 60,
    "bbox_padding_meters": 450.0,
    "max_station_distance_meters": 5000.0,
    "station_candidate_limit": 4,
    "max_snap_distance_meters": 300.0,
    "allow_partial_subject_failures": false,
    "confidence": 0.78,
    "boundary_landuse_values": ["residential"],
    "road_suffixes": ["Road", "Street", "Marg"],
    "highway_values": [
      "primary",
      "secondary",
      "tertiary",
      "unclassified",
      "residential",
      "service",
      "living_street",
      "pedestrian",
      "footway",
      "path",
      "steps"
    ]
  },
  "corridor": {
    "summary_fact_key": "transit_access_route",
    "summary_display_label": "Metro access",
    "linked_entity_fact_key": "transit_access_route_entity",
    "linked_entity_display_label": "Metro access map route",
    "route_mode": "ground_access"
  },
  "approach_road": {
    "summary_fact_key": "approach_road",
    "linked_entity_fact_key": "approach_road_entity"
  },
  "society_boundary": {
    "geometry_fact_key": "society.boundary_geojson"
  }
}
