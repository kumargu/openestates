{
  "version": 1,
  "description": "OpenStreetMap power-infrastructure selectors and buyer-facing risk thresholds.",
  "collector": {
    "source_id": "openstreetmap_power",
    "source_type": "OpenStreetMap",
    "fetch_source": "overpass_power_snapshot",
    "overpass_url_env": "OPENESTATES_OVERPASS_API_URL",
    "default_overpass_url": "https://overpass-api.de/api/interpreter",
    "query_timeout_seconds": 60,
    "bbox_padding_meters": 500.0,
    "fallback_to_subject_queries": true,
    "allow_partial_subject_failures": false,
    "subject_query_retry_count": 2,
    "subject_query_retry_delay_seconds": 20.0,
    "retry_status_codes": [429, 504],
    "confidence": 0.82,
    "voltage_query_values": ["66000", "110000", "132000", "220000", "400000", "765000"]
  },
  "transmission_lines": {
    "fact_key": "high_voltage_transmission_line_nearby",
    "display_label": "High-voltage transmission line nearby",
    "answers_preferences": ["avoid high tension wires", "avoid transmission line", "red flag", "power line"],
    "linked_place_fact_key": "high_voltage_transmission_line_place_entity",
    "linked_place_display_label": "High-voltage transmission line map entity",
    "accepted_power_values": ["line"],
    "min_voltage_kv": 66.0,
    "include_unknown_voltage": false,
    "max_distance_meters": 1000.0,
    "severity_bands": [
      { "severity": "critical", "max_distance_meters": 50.0 },
      { "severity": "high", "max_distance_meters": 150.0 },
      { "severity": "medium", "max_distance_meters": 300.0 },
      { "severity": "info", "max_distance_meters": 1000.0 }
    ]
  }
}
