{
  "version": 2,
  "description": "Dedicated RERA evidence report. Sections select accepted public evidence products and omit themselves when no matching data exists.",
  "sections": [
    {
      "id": "registration",
      "title": "Official registration record",
      "rank": 0,
      "renderer": "fact_list",
      "selectors": [
        { "key": "claim:official_registration_number", "label": "Registration number" },
        { "key": "claim:registry_acknowledgement_number", "label": "Acknowledgement number" },
        { "key": "claim:registry_project_name", "label": "Registered project" },
        { "key": "claim:registry_promoter_name", "label": "Promoter" }
      ],
      "empty_behavior": "omit",
      "fact_keys": [
        "official_registration_number",
        "registry_acknowledgement_number",
        "registry_project_name",
        "registry_promoter_name"
      ]
    },
    {
      "id": "schedule",
      "title": "Schedule, extensions and milestones",
      "rank": 1,
      "renderer": "timeline",
      "selectors": [
        { "key": "event:registration_start_date", "label": "Registration start" },
        { "key": "event:proposed_completion_date", "label": "Proposed completion" }
      ],
      "empty_behavior": "omit",
      "fact_keys": ["registration_start_date", "proposed_completion_date"]
    },
    {
      "id": "quarterly_progress",
      "title": "Quarterly progress",
      "rank": 2,
      "renderer": "series",
      "selectors": [
        { "key": "series:quarterly_inventory.total_units", "label": "Filed homes", "format": "integer" },
        { "key": "series:quarterly_inventory.booked_units", "label": "Booked", "format": "integer" },
        { "key": "series:quarterly_inventory.unsold_units", "label": "Unsold", "format": "integer" }
      ],
      "empty_behavior": "omit",
      "fact_keys": [
        "quarterly_filing_quarter",
        "quarterly_filing_financial_year",
        "quarterly_reported_tower_count",
        "quarterly_reported_total_units",
        "quarterly_reported_booked_units",
        "quarterly_reported_unsold_units"
      ]
    },
    {
      "id": "inventory",
      "title": "Homes and carpet area",
      "rank": 3,
      "renderer": "table",
      "selectors": [
        { "key": "entity:inventory_configuration", "label": "Configuration" },
        { "key": "claim:declared_unit_count", "label": "Declared homes", "format": "integer" },
        { "key": "claim:declared_project_total_carpet_area", "label": "Declared project carpet area", "format": "square_metres" },
        { "key": "claim:declared_inventory_total_unit_count", "label": "Inventory total", "format": "integer" },
        { "key": "claim:declared_inventory_unit_count", "label": "Homes", "format": "integer" },
        { "key": "claim:declared_inventory_total_carpet_area", "label": "Total carpet area", "format": "square_metres" },
        { "key": "claim:declared_inventory_filed_carpet_area", "label": "Filed carpet area", "format": "square_metres" },
        { "key": "claim:declared_inventory_total_balcony_verandah_area", "label": "Total balcony area", "format": "square_metres" },
        { "key": "claim:declared_inventory_filed_balcony_verandah_area", "label": "Filed balcony area", "format": "square_metres" }
      ],
      "empty_behavior": "omit",
      "key_prefixes": ["declared_inventory_"],
      "fact_keys": ["declared_unit_count", "declared_project_total_carpet_area"]
    },
    {
      "id": "plans",
      "title": "Plans",
      "rank": 4,
      "renderer": "plans",
      "selectors": [
        { "key": "fact:media.project_plan_frames", "label": "Plans" }
      ],
      "preview_kinds": [
        "site_plan",
        "floor_plan",
        "section_plan",
        "development_plan",
        "sanction_plan"
      ],
      "items_per_page": 3,
      "empty_behavior": "omit",
      "fact_keys": ["media.project_plan_frames"]
    },
    {
      "id": "documents",
      "title": "Documents and approvals",
      "rank": 5,
      "renderer": "documents",
      "selectors": [
        { "key": "entity:document", "label": "Document" },
        { "key": "claim:document_quarter", "label": "Quarter" },
        { "key": "claim:document_financial_year", "label": "Financial year" },
        { "key": "claim:official_document_url", "label": "Source" }
      ],
      "empty_behavior": "omit",
      "key_prefixes": ["document_", "official_document_"]
    },
    {
      "id": "complaints",
      "title": "Complaints and authority orders",
      "rank": 6,
      "renderer": "timeline",
      "selectors": [
        { "key": "claim:complaint_*", "label": "Complaint record" },
        { "key": "claim:authority_order_*", "label": "Authority order" }
      ],
      "empty_behavior": "omit",
      "key_prefixes": ["complaint_", "authority_order_"]
    },
    {
      "id": "finance",
      "title": "Financial declarations and charges",
      "rank": 7,
      "renderer": "fact_list",
      "selectors": [
        { "key": "claim:finance_*", "label": "Financial declaration" },
        { "key": "claim:declared_charge_*", "label": "Charge" }
      ],
      "empty_behavior": "omit",
      "key_prefixes": ["finance_", "declared_charge_"]
    },
    {
      "id": "water",
      "title": "Water and service declarations",
      "rank": 8,
      "renderer": "fact_list",
      "selectors": [
        { "key": "claim:declared_water_source", "label": "Declared water source" },
        { "key": "claim:declared_water_local_authority", "label": "Local authority" }
      ],
      "empty_behavior": "omit",
      "fact_keys": ["declared_water_source", "declared_water_local_authority"]
    }
  ],
  "default_section": {
    "id": "other",
    "title": "Other filed facts",
    "rank": 99
  }
}
