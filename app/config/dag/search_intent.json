{
  "_comment": "Search intent config. Keep parser vocabulary generic: broad Bengaluru regions and place families only. Named localities, roads, societies, schools, hospitals, tech parks, malls, and landmarks belong in DAG/serving entities and facts.",
  "version": 1,
  "description": "NL search parsing helpers. Broad region aliases are loaded from this file via dag_config; named places resolve through DAG/serving facts.",
  "buyer_archetypes": [
    {
      "id": "family",
      "label": "Family buyer",
      "signals": ["family", "schools", "3BHK", "kids", "society quality"]
    },
    {
      "id": "investor",
      "label": "Investor",
      "signals": ["investment", "rental yield", "appreciation", "resale"]
    },
    {
      "id": "risk_averse",
      "label": "Risk-averse",
      "signals": ["legal", "rera", "litigation", "clear title", "reliable builder"]
    },
    {
      "id": "value_buyer",
      "label": "Value buyer",
      "signals": ["affordable", "budget", "value for money", "2BHK"]
    },
    {
      "id": "luxury_buyer",
      "label": "Luxury buyer",
      "signals": ["premium", "4BHK", "builder reputation", "luxury"]
    },
    {
      "id": "end_user",
      "label": "End user",
      "signals": ["self use", "own stay", "long term"]
    }
  ],
  "area_aliases": {
    "city": "bengaluru",
    "entries": [
      {
        "canonical": "East Bengaluru",
        "aliases": [
          "east bangalore",
          "east bengaluru",
          "east blr"
        ]
      },
      {
        "canonical": "West Bengaluru",
        "aliases": [
          "west bangalore",
          "west bengaluru",
          "west blr"
        ]
      },
      {
        "canonical": "South Bengaluru",
        "aliases": [
          "south bangalore",
          "south bengaluru",
          "south blr"
        ]
      },
      {
        "canonical": "North Bengaluru",
        "aliases": [
          "north bangalore",
          "north bengaluru",
          "north blr"
        ]
      }
    ]
  },
  "resolution": {
    "min_resolvable_entity_name_chars": 3,
    "ignored_entity_names": ["a", "an", "the", "in", "near", "for", "with"],
    "place_families": [
      {
        "id": "metro",
        "label": "metro",
        "aliases": ["metro", "metro station", "station"]
      },
      {
        "id": "school",
        "label": "school",
        "aliases": ["school", "schools", "kid school", "children school"]
      },
      {
        "id": "hospital",
        "label": "hospital",
        "aliases": ["hospital", "hospitals", "clinic", "medical"]
      },
      {
        "id": "tech_park",
        "label": "tech park",
        "aliases": ["tech park", "tech parks", "office", "offices"]
      },
      {
        "id": "mall",
        "label": "mall",
        "aliases": ["mall", "shopping mall"]
      },
      {
        "id": "landmark",
        "label": "landmark",
        "aliases": ["landmark"]
      }
    ]
  },
  "parser": {
    "bhk": {
      "unit_aliases": [
        "bhk"
      ],
      "number_words": [
        {
          "word": "one",
          "value": 1
        },
        {
          "word": "two",
          "value": 2
        },
        {
          "word": "three",
          "value": 3
        },
        {
          "word": "four",
          "value": 4
        },
        {
          "word": "five",
          "value": 5
        },
        {
          "word": "six",
          "value": 6
        }
      ],
      "min": 1,
      "max": 6
    },
    "budget": {
      "operators": [
        "under",
        "undr",
        "below",
        "budget",
        "max",
        "within",
        "upto",
        "up to"
      ],
      "units": [
        {
          "unit": "crore",
          "aliases": [
            "cr",
            "crore",
            "crores"
          ],
          "multiplier": 10000000.0
        },
        {
          "unit": "lakh",
          "aliases": [
            "l",
            "lakh",
            "lakhs"
          ],
          "multiplier": 100000.0
        }
      ]
    },
    "distance": {
      "operators": [
        "within",
        "under",
        "below",
        "max",
        "upto",
        "up to",
        "less than",
        "inside",
        "limit"
      ],
      "units": [
        {
          "unit": "km",
          "aliases": [
            "km",
            "kms",
            "kilometer",
            "kilometers"
          ],
          "multiplier": 1.0
        },
        {
          "unit": "m",
          "aliases": [
            "m",
            "meter",
            "meters",
            "metre",
            "metres"
          ],
          "multiplier": 0.001
        }
      ]
    },
    "relations": {
      "aliases": [
        {
          "alias": "near"
        },
        {
          "alias": "nearby"
        },
        {
          "alias": "near by"
        },
        {
          "alias": "within",
          "requires_distance_limit": true
        },
        {
          "alias": "close to"
        }
      ]
    }
  },
  "hard_constraint_dimensions": [
    {
      "field": "land_area",
      "registry_ref": "app/config/dag/fact_registry.json numeric_constraints"
    }
  ]
}
