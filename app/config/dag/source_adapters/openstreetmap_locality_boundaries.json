{
  "version": 1,
  "source": "OpenStreetMap",
  "asset_id": "osm_locality_boundary_facts",
  "collection": {
    "transport": "overpass",
    "scope": "configured administrative boundary levels within the broad market region",
    "broad_region": {
      "id": "bengaluru_market_region",
      "bbox": [12.75, 77.35, 13.20, 77.95]
    },
    "admin_levels": [9, 10, 11],
    "output_mode": "body geom",
    "request_path_allowed": false
  },
  "output": {
    "entity_type": "area",
    "fact_keys": [
      "place.name",
      "place.category",
      "area.admin_level",
      "area.osm_boundary_members",
      "geo.geometry_geojson"
    ],
    "derived_relations": ["in_area", "adjacent_area"]
  },
  "quality": {
    "reject_missing_or_open_geometry": true,
    "never_infer_locality_from_society_boundary": true,
    "ambiguous_containment_is_data_gap": true
  }
}
