{
  "_comment": "Buyer-facing RERA project plans. Exact catalog registrations are fetched and auto-validated offline; request paths only read promoted preview refs.",
  "version": 2,
  "source_id": "rera_project_plans",
  "source_type": "Rera",
  "trust_tier": "root",
  "max_confidence": 0.9,
  "request_path_policy": {
    "allow_runtime_downloads": false,
    "allow_runtime_pdf_parsing": false,
    "allow_runtime_image_conversion": false,
    "required_join_phase": "dag_materialization"
  },
  "serving_fact_key": "media.project_plan_frames",
  "selection": {
    "policy_path": "app/config/dag/source_adapters/rera_document_previews.json",
    "automatic_promotion": true,
    "manual_approval": false,
    "max_previews_per_society": 3
  },
  "artifact_kinds": {
    "site_overview": {
      "buyer_surface": "property_detail",
      "policy": "one_optimized_preview_only",
      "exclude": ["brochure", "project_media", "legal_or_contract_document", "private_or_financial_document"]
    },
    "floor_plan": {
      "buyer_surface": ["property_detail", "compare_floor_plan_mode"],
      "policy": "one_representative_preview_per_configuration",
      "required_fields": [
        "configuration_type",
        "bedroom_count",
        "preview_url",
        "carpet_area_sqft",
        "sale_area_sqft"
      ]
    }
  },
  "promoted_fact_keys": [
    "media.project_plan_frames",
    "floor_plan_asset_count",
    "site_plan_asset_count",
    "available_configurations",
    "has_1bhk",
    "has_2bhk",
    "has_3bhk",
    "has_4bhk"
  ],
  "do_not_promote_fact_keys": [
    "brochure_available"
  ]
}
