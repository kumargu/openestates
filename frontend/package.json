{
  "name": "openestates-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "node ./node_modules/vite/bin/vite.js",
    "dev:atlas": "node ./node_modules/vite/bin/vite.js --mode atlas",
    "build": "tsc -b && node ./node_modules/vite/bin/vite.js build",
    "lint": "eslint . --max-warnings=0",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:smoke": "node --experimental-strip-types --test tests/*.smoke.test.ts",
    "test:atlas-browser": "playwright test --config playwright.atlas.config.ts",
    "test:atlas-parity": "playwright test --config playwright.atlas.config.ts e2e/atlas/parity.spec.ts",
    "atlas:lab": "node scripts/atlas-lab.mjs",
    "atlas:lab:full": "node scripts/atlas-lab.mjs --full",
    "atlas:lab:serve": "npm run dev:atlas -- --host 127.0.0.1 --port 5173",
    "verify:dist": "node scripts/verify-dist.mjs",
    "smoke": "npm run build && npm run verify:dist && npm run test:smoke",
    "preview": "node ./node_modules/vite/bin/vite.js preview"
  },
  "dependencies": {
    "maplibre-gl": "^5.24.0",
    "motion": "^12.43.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1"
  }
}
