{
  "name": "openestates-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "node ./node_modules/vite/bin/vite.js",
    "dev:atlas": "node ./node_modules/vite/bin/vite.js --mode atlas",
    "dev:waterford": "node ./node_modules/vite/bin/vite.js --mode waterford",
    "dev:inventory": "vite --mode inventory --host 127.0.0.1 --port 5192 --strictPort",
    "dev:inventory-scenarios": "vite --config prototypes/inventory-truth/vite.config.ts",
    "dev:inventory-api": "node prototypes/inventory-truth/serve-api.mjs",
    "contracts:inventory": "CARGO_REGISTRIES_CRATES_IO_PROTOCOL=git cargo run --quiet --manifest-path ../backend/prototypes/inventory-truth/Cargo.toml -- schema prototypes/inventory-truth/generated/schema && node scripts/generate-wire-types.mjs prototypes/inventory-truth/generated",
    "build:inventory": "tsc -p prototypes/inventory-truth/tsconfig.json && vite build --config prototypes/inventory-truth/vite.config.ts",
    "test:inventory-browser": "playwright test --config playwright.inventory.config.ts",
    "build": "tsc -b && node ./node_modules/vite/bin/vite.js build",
    "lint": "eslint . --max-warnings=0",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:smoke": "node --experimental-strip-types --test tests/*.smoke.test.ts",
    "test:search-browser": "playwright test --config playwright.search.config.ts",
    "test:atlas-browser": "playwright test --config playwright.atlas.config.ts",
    "test:atlas-parity": "playwright test --config playwright.atlas.config.ts e2e/atlas/parity.spec.ts",
    "verify:dist": "node scripts/verify-dist.mjs",
    "smoke": "npm run build && npm run verify:dist && npm run test:smoke",
    "preview": "node ./node_modules/vite/bin/vite.js preview",
    "contracts:generate": "cargo run --manifest-path ../backend/Cargo.toml --bin openestates-contract-schema && node scripts/generate-wire-types.mjs",
    "contracts:check": "npm run contracts:generate && git diff --exit-code -- src/generated",
    "test:contract-browser": "playwright test --config playwright.contracts.config.ts",
    "test:promotion-browser": "playwright test --config playwright.promotion.config.ts"
  },
  "dependencies": {
    "maplibre-gl": "^5.24.0",
    "motion": "^12.43.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "ajv": "^8.20.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "json-schema-to-typescript": "^15.0.4",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1"
  }
}
