    "KgEntityRefs": {
      "description": "Minimal entity identity bundle attached to property/search/detail responses.\n\nThese fields are stable API identifiers, not display copy and not a complete\nserving export. They exist so the UI can ask follow-up endpoints for richer\ncontext when a user shows intent: opens a property, expands a card, compares\nhomes, clicks a source trail, or requests a nearby/risk/community breakdown.\n\nCurrent usage pattern:\n1. Render fast listing data from `PropertyCard` or `PropertyDetailResponse`.\n2. Use `source_entity_ids` as opaque provenance handles for the property,\n   society, area, and builder.\n3. Use source/evidence read models when the UI needs a larger drill-down\n   such as builder portfolio, nearby projects, or lineage.\n4. Build optional UI sections from facts with source/confidence metadata.\n5. Hide sections that have no backed facts instead of rendering empty cards.\n\nImportant distinction: these are KG node IDs, not necessarily canonical RERA\nIDs. Some societies have an alias node such as `society:prestige-park-grove`\nwhile lake artifacts may also contain a RERA-rooted canonical ID. The UI\nshould not infer canonicalization from the string shape. It should treat the\nIDs as opaque handles and follow the API.",
      "type": "object",
      "properties": {
        "area_entity_id": {
          "description": "Area/locality node for traffic, waterlogging, metro, schools, price trend,\nand other externalities.",
          "type": "string"
        },
        "builder_entity_id": {
          "description": "Builder node when the society has a known BuiltBy edge in the KG.",
          "type": "string"
        },
        "property_entity_id": {
          "description": "Listing-level node for facts specific to this flat/unit/listing.",
          "type": "string"
        },
        "society_entity_id": {
          "description": "Society/project node for RERA, reviews, nearby places, amenities, and\ncommunity evidence.",
          "type": "string"
        },
        "source_entity_ids": {
          "description": "Existing graph nodes the UI can safely prefetch first.\n\nThis list is backend-filtered to nodes present in the current KG, sorted,\nand deduplicated. It may omit an otherwise valid field ID if that node has\nnot been materialized yet. UI code should treat it as a convenient fetch\nplan, not as a complete semantic model.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "property_entity_id",
        "society_entity_id",
        "area_entity_id"
      ]
    },
    "ProofFocusStatus": {
      "type": "string",
      "enum": [
