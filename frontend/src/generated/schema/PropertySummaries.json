{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PropertySummaries",
  "type": "object",
  "properties": {
    "contractVersion": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/PropertyCard"
      }
    },
    "missingIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "snapshotIdentity": {
      "type": "string"
    }
  },
  "required": [
    "contractVersion",
    "snapshotIdentity",
    "items",
    "missingIds"
  ],
  "definitions": {
    "Availability": {
      "type": "string",
      "enum": [
        "available",
        "unavailable"
      ]
    },
    "DataFreshness": {
      "description": "Legacy optional API shape. Search and detail responses do not calculate\nfreshness or age from timestamps.",
      "type": "object",
      "properties": {
        "days_ago": {
          "description": "How many days ago the node was last updated",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "fact_count": {
          "description": "Total number of facts on the node",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "freshness_label": {
          "description": "Human-readable label: \"Fresh\", \"Recent\", \"Stale\", \"Very stale\"",
          "type": "string"
        },
        "last_enriched": {
          "description": "ISO timestamp of last enrichment",
          "type": "string"
        },
        "source_breakdown": {
          "description": "Breakdown of facts by source type, e.g. {\"Rera\": 5, \"Reddit\": 3}",
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "format": "uint32",
            "minimum": 0
          }
        }
      },
      "required": [
        "last_enriched",
        "days_ago",
        "freshness_label",
        "fact_count",
        "source_breakdown"
      ]
    },
    "DecisionCheckSummary": {
      "type": "object",
      "properties": {
        "groups": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/DecisionLabelGroup"
          }
        },
        "primaryCount": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "primaryLabels": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/DecisionLabel"
          }
        },
        "registrationNumber": {
          "type": "string"
        },
        "registrationNumberCompact": {
          "type": "string"
        },
        "registryUrl": {
          "type": "string"
        },
        "tileCaption": {
          "type": "string"
        },
        "tileLabel": {
          "type": "string"
        },
        "tone": {
          "type": "string"
        },
        "totalCount": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        }
      },
      "required": [
        "tileLabel",
        "tone",
        "primaryCount",
        "totalCount"
      ]
    },
    "DecisionLabel": {
      "type": "object",
      "properties": {
        "compareGroup": {
          "type": "string"
        },
        "confidence": {
          "type": "number",
          "format": "float"
        },
        "groupId": {
          "type": "string"
        },
        "key": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "notebookLabels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "placement": {
          "type": "string"
        },
        "priority": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "scope": {
          "type": "string"
        },
        "severity": {
          "type": "string"
        },
        "sourceFactKeys": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "surfaces": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unit": {
          "type": "string"
        },
        "value": {
          "type": "number",
          "format": "double"
        },
        "valueText": {
          "type": "string"
        },
        "visualId": {
          "type": "string"
        }
      },
      "required": [
        "key",
        "label",
        "severity",
        "scope",
        "visualId",
        "priority",
        "confidence",
        "groupId",
        "placement"
      ]
    },
    "DecisionLabelGroup": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "labels": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/DecisionLabel"
          }
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "labels"
      ]
    },
    "EvidenceId": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "observation"
            }
          },
          "required": [
            "kind",
            "id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "derivation"
            }
          },
          "required": [
            "kind",
            "id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "entity"
            }
          },
          "required": [
            "kind",
            "id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "relationship"
            }
          },
          "required": [
            "kind",
            "id"
          ]
        }
      ]
    },
    "EvidenceRef": {
      "type": "object",
      "properties": {
        "evidence_id": {
          "$ref": "#/definitions/EvidenceId"
        },
        "snapshot_identity": {
          "type": "string"
        },
        "subject_entity_id": {
          "type": "string"
        }
      },
      "required": [
        "snapshot_identity",
        "subject_entity_id",
        "evidence_id"
      ]
    },
    "InventoryAvailability": {
      "type": "object",
      "properties": {
        "area": {
          "$ref": "#/definitions/Availability"
        },
        "bedrooms": {
          "$ref": "#/definitions/Availability"
        },
        "price": {
          "$ref": "#/definitions/Availability"
        }
      },
      "required": [
        "bedrooms",
        "price",
        "area"
      ]
    },
    "KgEntityRefs": {
      "description": "Minimal entity identity bundle attached to property/search/detail responses.\n\nThese fields are stable API identifiers, not display copy and not a complete\nserving export. They exist so the UI can ask follow-up endpoints for richer\ncontext when a user shows intent: opens a property, expands a card, compares\nhomes, clicks a source trail, or requests a nearby/risk/community breakdown.\n\nCurrent usage pattern:\n1. Render fast listing data from `PropertyCard` or `PropertyDetailResponse`.\n2. Use `source_entity_ids` as opaque provenance handles for the property,\n   society, area, and builder.\n3. Use source/evidence read models when the UI needs a larger drill-down\n   such as builder portfolio, nearby projects, or lineage.\n4. Build optional UI sections from facts with source/confidence metadata.\n5. Hide sections that have no backed facts instead of rendering empty cards.\n\nImportant distinction: these are KG node IDs, not necessarily canonical RERA\nIDs. Some societies have an alias node such as `society:prestige-park-grove`\nwhile lake artifacts may also contain a RERA-rooted canonical ID. The UI\nshould not infer canonicalization from the string shape. It should treat the\nIDs as opaque handles and follow the API.",
      "type": "object",
      "properties": {
        "area_entity_id": {
          "description": "Area/locality node for traffic, waterlogging, metro, schools, price trend,\nand other externalities.",
          "type": "string"
        },
        "builder_entity_id": {
          "description": "Builder node when the society has a known BuiltBy edge in the KG.",
          "type": "string"
        },
        "property_entity_id": {
          "description": "Listing-level node for facts specific to this flat/unit/listing.",
          "type": "string"
        },
        "society_entity_id": {
          "description": "Society/project node for RERA, reviews, nearby places, amenities, and\ncommunity evidence.",
          "type": "string"
        },
        "source_entity_ids": {
          "description": "Existing graph nodes the UI can safely prefetch first.\n\nThis list is backend-filtered to nodes present in the current KG, sorted,\nand deduplicated. It may omit an otherwise valid field ID if that node has\nnot been materialized yet. UI code should treat it as a convenient fetch\nplan, not as a complete semantic model.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "property_entity_id",
        "society_entity_id",
        "area_entity_id"
      ]
    },
    "Measurement": {
      "description": "A measurement is never a display number: its basis, scope and receipt travel together.",
      "type": "object",
      "properties": {
        "basis": {
          "type": "string"
        },
        "entityId": {
          "type": "string"
        },
        "evidence": {
          "$ref": "#/definitions/EvidenceRef"
        },
        "maximum": {
          "type": "number",
          "format": "double"
        },
        "minimum": {
          "type": "number",
          "format": "double"
        },
        "unit": {
          "type": "string"
        },
        "value": {
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "value",
        "unit",
        "basis",
        "entityId",
        "evidence"
      ]
    },
    "PropertyCard": {
      "description": "UI-ready property card for the results page.",
      "type": "object",
      "properties": {
        "area": {
          "type": "string"
        },
        "area_measurement": {
          "$ref": "#/definitions/Measurement"
        },
        "availability": {
          "$ref": "#/definitions/InventoryAvailability"
        },
        "bhk": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "builder_delivery_display": {
          "description": "Human-readable builder delivery track record, e.g. \"Builder delivers on time: 100% of projects\"",
          "type": "string"
        },
        "builder_name": {
          "type": "string"
        },
        "carpet_area_sqft": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "data_freshness": {
          "description": "Data freshness — how recent and rich the underlying data is",
          "allOf": [
            {
              "$ref": "#/definitions/DataFreshness"
            }
          ]
        },
        "decision_check_summary": {
          "description": "Grouped compact check summary for property details, compare, and notes.",
          "allOf": [
            {
              "$ref": "#/definitions/DecisionCheckSummary"
            }
          ]
        },
        "decision_labels": {
          "description": "Config-derived decision labels for compare, notes, and compact review surfaces.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/DecisionLabel"
          }
        },
        "description_summary": {
          "type": "string"
        },
        "facing": {
          "type": "string"
        },
        "floor": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "floor_plan_preview_url": {
          "description": "Representative floor-plan preview for this listing's BHK (compare-ready).",
          "type": "string"
        },
        "google_rating": {
          "type": "number",
          "format": "double"
        },
        "google_review_count": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "google_reviews_url": {
          "type": "string"
        },
        "hero_image": {
          "type": "string"
        },
        "home_state_display": {
          "description": "Compact buyer-facing state signal for result tiles, e.g. \"Delivered · 5-10 yrs old\".",
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "images": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "kg_entity_refs": {
          "description": "Stable entity handles attached to the serving bundle.\n\nThis is the contract that keeps cards and detail pages from becoming a\nfixed list of hardcoded sections. The flat fields in `PropertyCard`\nsupport fast first paint and search-result scanning. `kg_entity_refs`\nsupports the second layer: expandable evidence, compare rows, side\npanels, source drill-down, and dynamic sections that only appear when\nfacts actually exist.\n\nBackend rules:\n- Populate these IDs from app-owned entity identity, never from UI labels.\n- Add new fact families to serving/source panels instead of adding\n  one-off card fields unless the value is needed on the hot first-paint path.\n- It is okay for some referenced concepts to have sparse facts. The UI\n  should render from fact availability and confidence.",
          "allOf": [
            {
              "$ref": "#/definitions/KgEntityRefs"
            }
          ]
        },
        "metro_distance_mins": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "open_space_pct": {
          "description": "RERA-backed open-area percentage. Omitted when the source did not expose it clearly.",
          "type": "number",
          "format": "double"
        },
        "plan_carpet_area_sqft": {
          "description": "Plan carpet area (sqft) for the matched configuration.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "plan_configuration_type": {
          "description": "Matched configuration label, e.g. \"3BHK\".",
          "type": "string"
        },
        "plan_sale_area_sqft": {
          "description": "Plan sale / super built-up area (sqft) for usable-space compare.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "possession_status": {
          "type": "string"
        },
        "price": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "price_max": {
          "description": "Inclusive listing band when the source is a range, not a point asking price.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "price_min": {
          "description": "Inclusive listing band when the source is a range, not a point asking price.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "price_per_sqft": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "project_status": {
          "description": "Machine-readable project status: \"ready_to_move\", \"under_construction\", etc.",
          "type": "string"
        },
        "project_status_display": {
          "description": "Human-readable project status from skill's display_template, e.g. \"Ready to Move — delivered 31/01/2020\"",
          "type": "string"
        },
        "root_source": {
          "description": "Where the society data originally came from: \"rera\", \"seller\", \"discovered\", \"legacy\"",
          "type": "string"
        },
        "society_land_acres": {
          "description": "RERA-backed project land extent. Kept on the card because compare needs it at first paint.",
          "type": "number",
          "format": "double"
        },
        "society_name": {
          "type": "string"
        },
        "sqft": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "super_builtup_sqft": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "title": {
          "type": "string"
        },
        "total_floors": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "transparency_tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "availability",
        "id",
        "kg_entity_refs",
        "title",
        "area",
        "society_name",
        "builder_name",
        "hero_image",
        "transparency_tags",
        "description_summary",
        "possession_status",
        "metro_distance_mins",
        "floor",
        "total_floors",
        "facing"
      ]
    }
  }
}
