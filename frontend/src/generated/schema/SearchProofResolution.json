{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ProofResolution",
  "type": "object",
  "properties": {
    "branchId": {
      "type": "string"
    },
    "catalogEvidence": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/CatalogEvidence"
      }
    },
    "claim": {
      "$ref": "#/definitions/EvaluatedClaim"
    },
    "constraint": {
      "$ref": "#/definitions/HardConstraint"
    },
    "contractVersion": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "derivationChain": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/DerivedEvidence"
      }
    },
    "factKey": {
      "type": "string"
    },
    "geometry": true,
    "predicateId": {
      "type": "string"
    },
    "propertyId": {
      "type": "string"
    },
    "relation": {
      "type": "string"
    },
    "resolutionStatus": {
      "$ref": "#/definitions/ProofResolutionStatus"
    },
    "semanticFingerprint": {
      "type": "string"
    },
    "snapshotIdentity": {
      "type": "string"
    },
    "sourceObservations": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/ResolvedSourceObservation"
      }
    },
    "subjectEntityId": {
      "type": "string"
    },
    "targetEntityId": {
      "type": "string"
    },
    "targetLabel": {
      "type": "string"
    },
    "unit": {
      "type": "string"
    },
    "value": {
      "$ref": "#/definitions/FactValue"
    }
  },
  "required": [
    "contractVersion",
    "snapshotIdentity",
    "semanticFingerprint",
    "propertyId",
    "branchId",
    "predicateId",
    "subjectEntityId",
    "factKey",
    "relation",
    "sourceObservations",
    "derivationChain",
    "resolutionStatus"
  ],
  "definitions": {
    "CatalogEvidence": {
      "description": "Promoted catalog records support identity claims without fabricated observations.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "entityId": {
              "type": "string"
            },
            "entityType": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "entity"
            },
            "name": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "entityId",
            "entityType",
            "name"
          ]
        },
        {
          "type": "object",
          "properties": {
            "confidence": {
              "type": "number",
              "format": "float"
            },
            "fromEntityId": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "relationship"
            },
            "relation": {
              "type": "string"
            },
            "relationshipId": {
              "type": "string"
            },
            "sourceType": {
              "type": "string"
            },
            "toEntityId": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "relationshipId",
            "fromEntityId",
            "toEntityId",
            "relation",
            "sourceType",
            "confidence"
          ]
        }
      ]
    },
    "ConstraintOperator": {
      "type": "string",
      "enum": [
        "min",
        "max"
      ]
    },
    "DerivedEvidence": {
      "type": "object",
      "properties": {
        "algorithm_version": {
          "type": "string"
        },
        "confidence": {
          "type": "number",
          "format": "float"
        },
        "derivation_id": {
          "type": "string"
        },
        "input_evidence": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/EvidenceRef"
          }
        },
        "metric": {
          "type": "string"
        },
        "relation": {
          "type": "string"
        },
        "snapshot_identity": {
          "type": "string"
        },
        "subject_entity_id": {
          "type": "string"
        },
        "target_entity_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "value": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        }
      },
      "required": [
        "derivation_id",
        "snapshot_identity",
        "subject_entity_id",
        "target_entity_id",
        "relation",
        "metric",
        "value",
        "unit",
        "algorithm_version",
        "confidence",
        "input_evidence"
      ]
    },
    "EvaluatedClaim": {
      "type": "object",
      "properties": {
        "dimension": {
          "type": "string"
        },
        "unit": {
          "type": "string"
        },
        "value": {
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "dimension",
        "value",
        "unit"
      ]
    },
    "EvidenceId": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "observation"
            }
          },
          "required": [
            "kind",
            "id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "derivation"
            }
          },
          "required": [
            "kind",
            "id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "entity"
            }
          },
          "required": [
            "kind",
            "id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "relationship"
            }
          },
          "required": [
            "kind",
            "id"
          ]
        }
      ]
    },
    "EvidenceRef": {
      "type": "object",
      "properties": {
        "evidence_id": {
          "$ref": "#/definitions/EvidenceId"
        },
        "snapshot_identity": {
          "type": "string"
        },
        "subject_entity_id": {
          "type": "string"
        }
      },
      "required": [
        "snapshot_identity",
        "subject_entity_id",
        "evidence_id"
      ]
    },
    "FactValue": {
      "description": "What kind of value a fact holds.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "data": {
              "type": "number",
              "format": "double"
            },
            "type": {
              "type": "string",
              "const": "Numeric"
            }
          },
          "required": [
            "type",
            "data"
          ]
        },
        {
          "type": "object",
          "properties": {
            "data": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "Text"
            }
          },
          "required": [
            "type",
            "data"
          ]
        },
        {
          "type": "object",
          "properties": {
            "data": {
              "type": "boolean"
            },
            "type": {
              "type": "string",
              "const": "Bool"
            }
          },
          "required": [
            "type",
            "data"
          ]
        },
        {
          "type": "object",
          "properties": {
            "data": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "type": {
              "type": "string",
              "const": "Tags"
            }
          },
          "required": [
            "type",
            "data"
          ]
        },
        {
          "type": "object",
          "properties": {
            "data": {
              "type": "object",
              "properties": {
                "explanation": {
                  "type": "string"
                },
                "value": {
                  "type": "number",
                  "format": "double"
                }
              },
              "required": [
                "value",
                "explanation"
              ]
            },
            "type": {
              "type": "string",
              "const": "Score"
            }
          },
          "required": [
            "type",
            "data"
          ]
        }
      ]
    },
    "HardConstraint": {
      "type": "object",
      "properties": {
        "field": {
          "description": "Registry dimension, e.g. \"land_area\".",
          "type": "string"
        },
        "operator": {
          "$ref": "#/definitions/ConstraintOperator"
        },
        "raw_text": {
          "type": "string"
        },
        "unit": {
          "type": "string"
        },
        "value": {
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "field",
        "operator",
        "value",
        "unit",
        "raw_text"
      ]
    },
    "ProofResolutionStatus": {
      "type": "string",
      "enum": [
        "resolved"
      ]
    },
    "ResolvedSourceObservation": {
      "type": "object",
      "properties": {
        "assetLineage": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "observationId": {
          "type": "string"
        },
        "observedAt": {
          "type": "string",
          "format": "date-time"
        },
        "provider": {
          "type": "string"
        },
        "providerObservationId": {
          "type": "string"
        },
        "sourceUrl": {
          "type": "string"
        },
        "subjectEntityId": {
          "type": "string"
        }
      },
      "required": [
        "observationId",
        "provider",
        "providerObservationId",
        "subjectEntityId",
        "observedAt",
        "assetLineage"
      ]
    }
  }
}
